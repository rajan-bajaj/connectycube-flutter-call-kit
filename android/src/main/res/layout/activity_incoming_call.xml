<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Background Color Overlay -->
    <View
        android:id="@+id/background_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#009FE3" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- Top Header (Generic) -->
        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close_white"
                app:tint="#FFFFFF"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/context_info_txt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:alpha="0.8"
                tools:text="Location Info" />

        </LinearLayout>

        <!-- Central Call Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">

            <LinearLayout
                android:id="@+id/delivery_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_delivery_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/delivery_status_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="Incoming Call" />

                <!-- Caller Info Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar_img"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:shapeAppearanceOverlay="@style/circleImageView"
                        tools:ignore="ContentDescription"
                        tools:src="@drawable/photo_placeholder" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/user_name_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="Caller Name" />

                        <TextView
                            android:id="@+id/call_type_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#666666"
                            android:textSize="16sp"
                            tools:text="Audio Call" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="64dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Decline -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.skyfishjy.library.RippleBackground
                    android:id="@+id/reject_button_animation"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:rb_color="#FFCDD2"
                    app:rb_duration="2000"
                    app:rb_radius="24dp"
                    app:rb_rippleAmount="4"
                    app:rb_scale="2">

                    <ImageView
                        android:id="@+id/end_call_btn"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/shape_action_deny"
                        android:onClick="onEndCall"
                        android:padding="16dp"
                        android:src="@drawable/ic_close_red"
                        tools:ignore="ContentDescription" />
                </com.skyfishjy.library.RippleBackground>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Decline"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="80dp"
                android:layout_height="0dp" />

            <!-- Accept -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.skyfishjy.library.RippleBackground
                    android:id="@+id/accept_button_animation"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:rb_color="#C8E6C9"
                    app:rb_duration="2000"
                    app:rb_radius="24dp"
                    app:rb_rippleAmount="4"
                    app:rb_scale="2">

                    <ImageView
                        android:id="@+id/start_call_btn"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/shape_action_approve"
                        android:onClick="onStartCall"
                        android:padding="16dp"
                        android:src="@drawable/ic_check_white"
                        tools:ignore="ContentDescription" />
                </com.skyfishjy.library.RippleBackground>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Accept"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Brand Footer -->
        <TextView
            android:id="@+id/footer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:text="Aarvy Office"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:alpha="0.8"/>

    </RelativeLayout>
</FrameLayout>